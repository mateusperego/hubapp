# Copie para .env e preencha. O .env não vai para o git.

# Chaves privadas das service accounts do Firebase, uma por cliente.
COPTIL_FIREBASE_PRIVATE_KEY=
COOPROLAT_FIREBASE_PRIVATE_KEY=

# Relay de suporte remoto (docs/relay-protocol.md).
# Gere o token com: openssl rand -hex 32
# O mesmo valor vai no painel (Configuração > token) e no SUPPORT_TOKEN do app.
RELAY_TOKEN=
RELAY_PORT=8443

# seller_id liberados, separados por vírgula. Vazio libera todos.
RELAY_SELLER_ALLOWLIST=
