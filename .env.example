# Só para desenvolvimento local: copie para .env e preencha.
# O .env não vai para o git (ver .gitignore).
#
# Em produção (Jelastic) NÃO existe .env. Cadastre cada variável abaixo no
# painel: nó Apache > Additionally (⋮) > Variables > Add > Apply, e reinicie o
# nó — as variáveis só entram no processo do httpd depois do restart.
# Exceção: o relay é um processo CLI e não herda as Variables do nó; ele lê um
# arquivo próprio fora do webroot (ver docs/relay-protocol.md).

# Chaves privadas das service accounts do Firebase, uma por cliente.
# Em uma linha só, com os \n escapados — é o formato que o campo do Jelastic
# aceita, e o mesmo do campo "private_key" do JSON baixado do Firebase.
COPTIL_FIREBASE_PRIVATE_KEY=
COOPROLAT_FIREBASE_PRIVATE_KEY=

# Relay de suporte remoto (docs/relay-protocol.md).
# Gere o token com: openssl rand -hex 32
# O mesmo valor vai no painel (Configuração > token) e no SUPPORT_TOKEN do app.
RELAY_TOKEN=
RELAY_PORT=8443

# seller_id liberados, separados por vírgula. Vazio libera todos.
RELAY_SELLER_ALLOWLIST=
