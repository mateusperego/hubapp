# Segredos: chaves privadas do Firebase e token do relay.
.env

# Dados de runtime: JSON dos clientes, PDFs gerados, imagens, logs e cache de token.
# Precisam de volume persistente no Jelastic — não são versionados.
storage/

# vendor/ NÃO entra aqui de propósito: o deploy deste projeto é por git pull,
# com as dependências já versionadas. Ignorá-lo deixaria o servidor sem elas.
#
# O que o Workerman escreve em runtime, porém, não pode ser versionado: ele
# grava dentro de vendor/, e o servidor grava nos mesmos caminhos. Versionados,
# o próximo `git pull` falharia com "local changes would be overwritten" — ou
# seja, o deploy pararia de funcionar por causa de um log.
vendor/workerman/workerman.log
vendor/workerman/*.pid

.DS_Store
